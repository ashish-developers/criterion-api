# Copy to .env and fill in. Never commit .env. All values below are placeholders.
# The API reads the .env file in its own folder (api/.env), wherever it is started from.
# To use another file, set ENV_FILE=/path/to/file in the environment. Variables set in the
# environment (systemd, PM2, Docker) always override the file. Check with: npm run db:check

# --- Application ---------------------------------------------------------
APP_NAME=branding
# Customer-facing name used in emails.
BRAND_NAME=MingoKart
# local | test | production   (production disables the dev OTP and the mock gateway)
APP_ENV=local
APP_PORT=4001
# Full mount prefix of the REST API.
API_VERSION=/api/v1
# Public address of the Next.js web app (payment/email links, default CORS origin).
WEB_APP_URL=http://localhost:3001
# Optional comma-separated allow-list; defaults to WEB_APP_URL.
CORS_ORIGINS=
# Set true when running behind a reverse proxy / load balancer (real client IPs, secure cookies).
TRUST_PROXY=false
# Key for encrypting stored secrets (e.g. vendor bank details). 32+ random characters.
APP_KEY=change-me-to-a-long-random-string

# --- PostgreSQL ----------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=branding
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_LOGGING=false
# Integration tests use DB_NAME + "_test" unless this is set. It is reset on every run.
TEST_DB_NAME=

# --- Sessions ------------------------------------------------------------
# HMAC secret for access tokens, OTP and refresh-token hashes. 32+ random characters.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
# Defaults to true when APP_ENV=production.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Email one-time codes ------------------------------------------------
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
# Development/testing only: return the OTP to the verification screen.
# Ignored (always off) when APP_ENV=production.
SHOW_DEV_OTP=true

# --- Users created by organisation admins -------------------------------
# Development/testing only (refused when APP_ENV=production): initial password for accounts
# created by Business, Vendor and Platform admins. Users must change it on first login.
# Leave empty to send a secure, single-use set-password link instead (production behaviour).
DEV_DEFAULT_PASSWORD=
# Development only: include DEV_DEFAULT_PASSWORD in the welcome email.
DEV_EMAIL_DEFAULT_PASSWORD=false
# Hours a set-password invitation link stays valid.
INVITE_TTL_HOURS=72

# --- Email delivery ------------------------------------------------------
# log = write emails to the console (development); smtp = send via the server below.
MAIL_DRIVER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="MingoKart <no-reply@example.com>"

# --- Payments ------------------------------------------------------------
# mock = simulated gateway for development (refused when APP_ENV=production) | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Shipping ------------------------------------------------------------
# Tracking webhooks are verified as HMAC-SHA256(raw body, this secret) in X-Signature.
# Leave empty to disable the endpoint.
SHIPPING_WEBHOOK_SECRET=

# --- File storage --------------------------------------------------------
# local = files under STORAGE_LOCAL_PATH (served through authorised API routes only)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage/uploads
UPLOAD_MAX_MB=25

# --- Background jobs -----------------------------------------------------
# true stops the in-process scheduler (OTP cleanup, SLA checks, reminders).
DISABLE_SCHEDULER=false
