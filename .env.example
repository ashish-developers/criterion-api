# Copy to .env and fill in. Never commit .env. All values below are placeholders.
# The API reads the .env file in its own folder (api/.env), wherever it is started from.
# To use another file, set ENV_FILE=/path/to/file in the environment. Variables set in the
# environment (systemd, PM2, Docker) always override the file. Check with: npm run db:check

# --- Application ---------------------------------------------------------
APP_NAME=branding
# Customer-facing name used in emails.
BRAND_NAME=MingoKart
# local | test | production   (production disables the dev OTP and the mock gateway)
APP_ENV=local
APP_PORT=4001
# Full mount prefix of the REST API.
API_VERSION=/api/v1
# Public address of the Next.js web app (payment/email links, default CORS origin).
WEB_APP_URL=http://localhost:3001
# Optional comma-separated allow-list; defaults to WEB_APP_URL.
CORS_ORIGINS=
# Set true when running behind a reverse proxy / load balancer (real client IPs, secure cookies).
TRUST_PROXY=false
# Key for encrypting stored secrets (e.g. vendor bank details). 32+ random characters.
APP_KEY=change-me-to-a-long-random-string

# --- PostgreSQL ----------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=branding
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_LOGGING=false
# Integration tests use DB_NAME + "_test" unless this is set. It is reset on every run.
TEST_DB_NAME=

# --- Sessions ------------------------------------------------------------
# HMAC secret for access tokens, OTP and refresh-token hashes. 32+ random characters.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
# Defaults to true when APP_ENV=production.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Email one-time codes ------------------------------------------------
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
# Development/testing only: return the OTP to the verification screen.
# Ignored (always off) when APP_ENV=production.
SHOW_DEV_OTP=true

# --- Users created by organisation admins -------------------------------
# Development/testing only (refused when APP_ENV=production): initial password for accounts
# created by Business, Vendor and Platform admins. Users must change it on first login.
# Leave empty to send a secure, single-use set-password link instead (production behaviour).
DEV_DEFAULT_PASSWORD=
# Development only: include DEV_DEFAULT_PASSWORD in the welcome email.
DEV_EMAIL_DEFAULT_PASSWORD=false
# Hours a set-password invitation link stays valid.
INVITE_TTL_HOURS=72

# --- Email delivery (SMTP) -----------------------------------------------
# Shown read-only in the admin panel (Settings -> Email (SMTP) settings). Restart the API after
# changes. Check without sending an email: npm run config:check
# MAIL_DRIVER: log = write emails to the console (development); smtp = send via the server below.
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
# starttls (port 587) | ssl (port 465) | none (port 25, local servers only)
MAIL_ENCRYPTION=starttls
MAIL_USERNAME=
# Gmail / Google Workspace: a 16-character App Password, not the account password
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_REPLY_TO=

# --- Payments ------------------------------------------------------------
# Shown read-only in the admin panel (Settings -> Payment gateway settings). Restart the API after
# changes. Check without taking a payment: npm run config:check
# mock = also offer a simulated gateway for development (refused when APP_ENV=production) | none
PAYMENT_PROVIDER=none
# Gateway pre-selected at checkout when several are enabled: razorpay | paypal
PAYMENT_DEFAULT_GATEWAY=
# Public address of this API, shown as the webhook URL to register with each gateway
# (e.g. https://your-domain when the web app forwards /api/v1 to the API).
PUBLIC_API_URL=

# Razorpay (Dashboard -> Account & Settings -> API Keys). Mode test uses rzp_test_ keys, live rzp_live_.
RAZORPAY_ENABLED=false
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks: the secret chosen for <PUBLIC_API_URL>/api/v1/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# PayPal (Developer Dashboard -> Apps & Credentials). Mode test = Sandbox.
PAYPAL_ENABLED=false
PAYPAL_MODE=test
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The Webhook ID of <PUBLIC_API_URL>/api/v1/webhooks/paypal in your PayPal app
PAYPAL_WEBHOOK_ID=
# PayPal does not take INR: orders are charged in this currency at this rate (rupees per 1 unit)
PAYPAL_CURRENCY=USD
PAYPAL_EXCHANGE_RATE=85

# --- Shipping ------------------------------------------------------------
# Tracking webhooks are verified as HMAC-SHA256(raw body, this secret) in X-Signature.
# Leave empty to disable the endpoint.
SHIPPING_WEBHOOK_SECRET=

# --- File storage --------------------------------------------------------
# local = files under STORAGE_LOCAL_PATH (served through authorised API routes only)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage/uploads
UPLOAD_MAX_MB=25
# s3 = a private bucket on any S3-compatible service. Files stored locally before the switch
# are still read from disk when they are not in the bucket.
#   AWS S3:            S3_REGION=ap-south-1, S3_ENDPOINT empty, S3_FORCE_PATH_STYLE=false
#   Cloudflare R2:     S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
#   DigitalOcean:      S3_ENDPOINT=https://blr1.digitaloceanspaces.com, S3_REGION=blr1
#   MinIO (local):     S3_ENDPOINT=http://localhost:9000, S3_REGION=us-east-1
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Optional folder inside the bucket, e.g. uploads
S3_PREFIX=

# --- Antivirus -----------------------------------------------------------
# Uploads are scanned by a ClamAV daemon (clamd) when CLAMAV_HOST is set; an infected file is
# refused. Laragon/Windows: install ClamAV and run clamd; Linux: apt install clamav-daemon.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
# true = refuse uploads while the scanner is unreachable (otherwise they pass with a log warning)
CLAMAV_REQUIRED=false

# --- Background jobs -----------------------------------------------------
# true stops the in-process scheduler (OTP cleanup, SLA checks, reminders).
DISABLE_SCHEDULER=false
